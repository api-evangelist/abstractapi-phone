                  "description": "(Required) Your Abstract API Phone Validation API key."
                },
                {
                  "disabled": false,
                  "key": "phone",
                  "value": "<string>",
                  "description": "(Required) The phone number to validate and verify, ideally in E.164 format (e.g. +14152007986)."
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "Optional ISO 3166-1 alpha-2 country code used to interpret a phone number submitted without an international dialing code."
